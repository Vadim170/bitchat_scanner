<resources>
    <string name="app_name">BitChat Scanner</string>

    <!-- Permission Screen -->
    <string name="permissions_title">BitChat Scanner — разрешения</string>
    <string name="permissions_description">Чтобы сканировать узлы и строить карту покрытия, нужны следующие разрешения:</string>
    <string name="permission_bluetooth_title">Bluetooth (сканирование и подключение)</string>
    <string name="permission_bluetooth_subtitle">Нужно, чтобы искать устройства BitChat по BLE-сервису.</string>
    <string name="permission_location_title">Геопозиция (примерная + точная)</string>
    <string name="permission_location_subtitle">Нужна для BLE-сканирования на Android 11 и ниже. На Android 12+ необязательна и только добавляет координаты к обнаружениям на переднем плане.</string>
    <string name="grant_permissions">Выдать разрешения</string>
    <string name="privacy_notice">История обнаружений хранится локально в приложении и не загружается на сервер приложения. При открытии карты для видимой области загружаются тайлы OpenStreetMap.</string>

    <!-- Main Screen -->
    <string name="menu">Меню</string>
    <string name="map">Карта</string>
    <string name="stop_scanner">Стоп сканера</string>
    <string name="start_scanner">Старт сканера</string>
    <string name="scan_visibility_note">Когда приложение видно, используется быстрый callback. После ухода Android сохраняет отфильтрованную BLE-подписку PendingIntent в режиме best effort. Система может ограничивать её, задерживать или пропускать объявления; фоновое сканирование не непрерывно и не гарантируется.</string>
    <string name="scan_state_visible">Активное сканирование (приложение видно)</string>
    <string name="scan_state_background">Пассивная фоновая подписка активна</string>
    <string name="scan_state_stopped">Сканер остановлен</string>
    <string name="scan_state_permission_required">Нет разрешения Bluetooth или точной геопозиции</string>
    <string name="scan_state_bluetooth_disabled">Bluetooth выключен</string>
    <string name="scan_state_unavailable">BLE-сканер недоступен</string>
    <string name="scan_state_error">Ошибка сканера — нажмите «Старт» для повтора</string>
    <string name="location_optional_title">Добавить точные координаты</string>
    <string name="location_optional_subtitle">На Android 12+ необязательно: сканирование и фоновые уведомления работают без геопозиции. Выдайте доступ к примерной + точной геопозиции, чтобы добавлять координаты к обнаружениям на переднем плане.</string>
    <string name="grant_location">Выдать геопозицию</string>
    <string name="notifications_title">Уведомления об обнаружениях</string>
    <string name="notifications_subtitle">Уведомлять о подходящих объявлениях BitChat (с паузой). На Android 13+ появится запрос разрешения; отказ отключит уведомления, но не остановит сканирование.</string>
    <string name="notification_channel_name">Обнаружения BitChat</string>
    <string name="notification_channel_description">Уведомления при обнаружении объявления BitChat.</string>
    <string name="notification_detection_title">Обнаружено устройство BitChat</string>
