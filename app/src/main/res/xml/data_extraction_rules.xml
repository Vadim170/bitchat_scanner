<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Cloud backup is already disabled by
     android:allowBackup="false"; the device-transfer rules additionally keep
     the local detection history and preferences out of device-to-device
     migration, which allowBackup alone does not guarantee on every OEM. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
